# MOB Guard backend configuration — copy to .env and fill in.
# NEVER commit a real .env file.

# Port the backend listens on
PORT=3000

# Secret used to sign JWTs. Generate a long random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetimes
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# JSON file used for persistence (no database required)
DATA_FILE=./backend/data.json

# CORS: '*' for development, or a comma-separated list of origins
CORS_ORIGIN=*

# Telemetry simulation tick interval (ms)
SIM_INTERVAL_MS=4000
